# Sendline API configuration.
#
# Copy to api/.env and fill in. Every secret below must be generated, not typed:
#   openssl rand -hex 32
# The upstream project shipped these with values like `secret` and
# `selfhostsim`; nothing in the code enforces that you change them, so this is
# on you. Run ./scripts/generate-secrets.sh to do it in one go.

PORT=3001

# --- Database -----------------------------------------------------------
# Must match MONGO_ROOT_USER / MONGO_ROOT_PASS in the root .env.
MONGO_ROOT_USER=sendline
MONGO_ROOT_PASS=CHANGE_ME_openssl_rand_hex_32
MONGO_URI=mongodb://sendline:CHANGE_ME_openssl_rand_hex_32@sendline-db:27017/sendline?authSource=admin

# --- Auth ---------------------------------------------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRATION=60d

# The admin user created on first boot. Change the password before the first
# time this is reachable from anything but localhost.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_pick_a_real_password

# --- Firebase (phase 1 only) -------------------------------------------
# Outbound SMS jobs reach the phone via FCM push. Create a free Firebase
# project, download the service-account JSON, and paste the fields here.
# Phase 2 replaces this with the phone polling the API over Tailscale, at
# which point every value below can be deleted.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_C509_CERT_URL=

# --- Send queue ---------------------------------------------------------
# Must stay true: the pacer depends on the queue. Sending without it means
# firing every message at once, which is how a SIM gets blocked.
USE_SMS_QUEUE=true
REDIS_URL=redis://sendline-redis:6379

# --- Email channel ------------------------------------------------------
# Any SMTP relay. Resend, SES and Postmark all work; a self-hosted MTA will
# land in spam and is not worth the weekend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Shop <hello@example.com>"

# --- Pacing defaults ----------------------------------------------------
# Overridable per campaign in the UI. These are the safe starting values.
SENDLINE_RATE_PER_MINUTE=10
SENDLINE_DAILY_CAP=500
SENDLINE_WINDOW_START_HOUR=9
SENDLINE_WINDOW_END_HOUR=20
SENDLINE_TIMEZONE=UTC

# Applied when a contact's phone number has no country code.
SENDLINE_DEFAULT_COUNTRY_CODE=
