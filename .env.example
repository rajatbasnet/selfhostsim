# Root compose configuration. Copy to .env.
# Secrets live in api/.env; these are the few values compose itself needs.

# Must match api/.env exactly, or the API cannot authenticate to Mongo.
MONGO_ROOT_USER=sendline
MONGO_ROOT_PASS=CHANGE_ME_openssl_rand_hex_32

PORT=3001
WEB_PORT=3000
MONGO_PORT=27018
REDIS_PORT=6379

USE_SMS_QUEUE=true
REDIS_URL=redis://sendline-redis:6379

# The address a BROWSER uses to reach the API. Baked into the web build, so
# change it and rebuild. Use your laptop's Tailscale address if you want the
# UI to work from your phone:  tailscale ip -4
PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
